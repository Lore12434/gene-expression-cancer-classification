# ==========================================
# Byte-compiled / cache files
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ==========================================
# Virtual Environments
# ==========================================
venv/
env/
.venv/
ENV/

# ==========================================
# Large Data Files (DO NOT PUSH TO GITHUB)
# ==========================================
# Raw TCGA files are hundreds of MBs and will be rejected by GitHub
data/raw/*
# Processed full datasets (X_train.csv has 20,531 columns and is too large)
data/processed/*

# Keep the folder structure in Git even if empty
!.gitkeep

# ==========================================
# Models
# ==========================================
# Keep final_pipeline_model (small, 39 features)
# Ignore large baseline models if they exceed 50-100MB
models/random_forest
models/random_forest_pca

# ==========================================
# Operating System & IDE junk
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/